# Template of the environment variables required by kayak.ipynb.
# Copy to .env and fill in with your own credentials — .env is git-ignored, this file is not.
#   cp .env.example .env

# --- OpenWeatherMap ---
# Free API key: https://openweathermap.org/appid
WEATHER_API_SECRET=

# --- Data lake: Cloudflare R2 (S3-compatible) ---
# Cloudflare dashboard > R2 > Manage API tokens > Create token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Account-specific endpoint, shown on the R2 overview page
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=

# --- Data warehouse: PostgreSQL (Neon) ---
# Neon console > your project > Connect > use the DIRECT hostname (without "-pooler")
HOST_SQL_ALCHEMY=ep-xxxx-xxxx.eu-central-1.aws.neon.tech
PORT_SQL_ALCHEMY=5432
DATABASE_SQL_ALCHEMY=neondb
USER_SQL_ALCHEMY=neondb_owner
PASSWORD_SQL_ALCHEMY=
